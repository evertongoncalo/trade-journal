# Copie para .env e ajuste. Nunca versione o .env.
JOURNAL_DB_PATH=data/journal.db

# --- Análise com IA (OpenRouter) ---
# Crie a chave em https://openrouter.ai/keys e coloque saldo em https://openrouter.ai/credits
# (a OpenRouter é uma conta e um saldo próprios, independentes de qualquer assinatura Claude).
OPENROUTER_API_KEY=
# Modelo, no formato da OpenRouter. Padrão: anthropic/claude-sonnet-5.5
# Mais barato para comparar: anthropic/claude-haiku-5.5
AI_MODEL=anthropic/claude-sonnet-5.5
# Esforço de raciocínio: low | medium | high (vazio = padrão do modelo). Raciocínio é cobrado como saída.
AI_REASONING_EFFORT=low
# AI_MAX_TOKENS=6000
# AI_TIMEOUT_SECONDS=120
# Avançado: outro endereço compatível com /chat/completions (padrão: a OpenRouter)
# OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions

# --- Alertas no Telegram ---
# 1) No Telegram, abra o @BotFather, envie /newbot e siga os passos: ele devolve um token.
# 2) Cole o token abaixo e reinicie o app. 3) Mande uma mensagem ao seu bot e, na aba Alertas, vincule a sua conversa.
# O token é um segredo: fica só aqui, nunca no git, no diário nem na tela.
TELEGRAM_BOT_TOKEN=
# Opcional: o id do chat de destino (se preferir não vincular pela tela; tem prioridade sobre o vínculo da tela).
# TELEGRAM_CHAT_ID=
# Avançado: outro endereço compatível com a API do Bot (padrão: https://api.telegram.org)
# TELEGRAM_API_URL=https://api.telegram.org
